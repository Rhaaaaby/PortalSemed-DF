FROM php:8.5-fpm-alpine

RUN apk add --no-cache postgresql-dev \
    && docker-php-ext-install pdo pdo_pgsql pgsql

WORKDIR /var/www/portalsemed

COPY app/ app/
COPY public/ public/
COPY vendor/ vendor/
COPY docker/php/production-entrypoint.sh /usr/local/bin/portal-entrypoint
COPY docker/php/production.ini /usr/local/etc/php/conf.d/zz-production.ini

RUN sed -i 's|^;pid = run/php-fpm.pid|pid = /tmp/php-fpm.pid|' /usr/local/etc/php-fpm.conf \
    && printf '\nclear_env = no\ncatch_workers_output = yes\n' >> /usr/local/etc/php-fpm.d/www.conf \
    && mkdir -p public/assets/images/uploads \
    && chown -R www-data:www-data public/assets/images/uploads \
    && chmod 0755 /usr/local/bin/portal-entrypoint

ENTRYPOINT ["portal-entrypoint"]
CMD ["php-fpm"]
