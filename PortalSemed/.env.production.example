# Copy to .env.production on the server and replace every example value.
APP_DOMAIN=portal.example.gov.br
APP_URL=https://portal.example.gov.br
APP_ENV=production

DB_NAME=portalsemed
DB_ADMIN_USER=portalsemed_admin
DB_ADMIN_PASSWORD_FILE=./.secrets/postgres_password
DB_USER=portalsemed_app
DB_PASSWORD_FILE=./.secrets/db_password

SMTP_HOST=smtp.example.gov.br
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD_FILE=./.secrets/smtp_password
SMTP_SECURE=tls
MAIL_FROM_EMAIL=your-email@example.com
MAIL_FROM_NAME=Portal SEMED
