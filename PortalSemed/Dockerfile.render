FROM php:8.5-fpm-alpine

RUN apk add --no-cache nginx postgresql-dev \
    && docker-php-ext-install pdo pdo_pgsql pgsql

WORKDIR /var/www/portalsemed

COPY app/ app/
COPY public/ public/
COPY vendor/ vendor/
COPY docker/php/production.ini /usr/local/etc/php/conf.d/zz-production.ini
COPY docker/render/nginx.conf /etc/nginx/http.d/default.conf
COPY docker/render/entrypoint.sh /usr/local/bin/render-entrypoint

RUN mkdir -p public/assets/images/uploads /run/nginx \
    && sed -i 's/\r$//' /usr/local/bin/render-entrypoint \
    && chown -R www-data:www-data public/assets/images/uploads \
    && printf '\nclear_env = no\ncatch_workers_output = yes\n' >> /usr/local/etc/php-fpm.d/www.conf \
    && chmod 0755 /usr/local/bin/render-entrypoint

ENTRYPOINT ["render-entrypoint"]
